# Copy this file to `.env` and fill in the values. `.env` is git-ignored; never commit real keys.

# Which provider to use: openai | gemini | auto  (auto = whichever key below is set; OpenAI if both).
LLM_PROVIDER=auto

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
# Optional: model (default gpt-4.1) and custom OpenAI-compatible endpoint.
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=

# --- Google Gemini, free tier (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional: model (default gemini-2.5-flash). The endpoint defaults to Gemini's OpenAI-compatible URL.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Optional ---
# GitHub token: only raises the GitHub API rate limit used by the github_actions tool for public
# repositories (a token with no scopes is enough). The agent works without it.
# GITHUB_TOKEN=
