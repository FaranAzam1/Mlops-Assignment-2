# Copy this file to `.env` and fill in the values. `.env` is git-ignored; never commit real keys.

# Required: API key for the LLM provider (OpenAI).
OPENAI_API_KEY=

# Optional: model name. Any chat model that supports tool/function calling works (default: gpt-4.1).
OPENAI_MODEL=gpt-4.1

# Optional: point the OpenAI SDK at an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# Optional: GitHub token. Only raises the GitHub API rate limit used by the github_actions tool
# for public repositories (a token with no scopes is enough). The agent works without it.
# GITHUB_TOKEN=
